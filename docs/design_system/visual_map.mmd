flowchart TD
    %% Node Definitions
    header[Header: 3px Bottom Border]
    sidebar[Sidebar: 3px Right Border]
    main[Main Content: Stark White]
    
    subgraph Components
        card[Card: 3px Border + 6px Hard Shadow]
        btn[Button: 2px Border + 4px Shadow]
        input[Input: 2px Border + Yellow Focus]
    end

    subgraph Typography
        head1[H1: 900 Black]
        head2[H2: 700 Bold Mono]
        body[Body: Mono Data]
    end

    %% Style assignments
    style header fill:#FFD338,stroke:#000,stroke-width:3px
    style btn fill:#FF90E8,stroke:#000,stroke-width:2px
    style card fill:#fff,stroke:#000,stroke-width:3px
    style input fill:#fff,stroke:#000,stroke-width:2px
    style main fill:#fff,stroke:#000,stroke-width:0px
